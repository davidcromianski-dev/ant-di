{
  "name": "@davidcromianski-dev/ant-di",
  "version": "2.0.1",
  "description": "Simple JavaScript Dependency Injection Container inspired by PHP Pimple with advanced features like auto-wiring and service providers",
  "keywords": [
    "dependency-injection",
    "di",
    "container",
    "typescript",
    "javascript",
    "auto-wiring",
    "service-provider",
    "singleton",
    "factory",
    "pimple"
  ],
  "author": {
    "name": "David Cromianski",
    "email": "davidcromianski.dev@gmail.com",
    "url": "https://github.com/davidcromianski-dev"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://davidcromianski-dev.github.io/ant-di/",
  "bugs": {
    "url": "https://github.com/davidcromianski-dev/ant-di/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/davidcromianski-dev/ant-di.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm build",
    "test": "poku",
    "test:coverage": "c8 poku",
    "test:watch": "poku --watch",
    "examples": "npx ts-node examples/examples.ts",
    "prepublish": "pnpm build && pnpm test",
    "publish:npm": "npm publish",
    "publish:dry-run": "npm publish --dry-run",
    "prepare": "husky",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "docs:generate": "typedoc",
    "docs:serve": "typedoc --serve",
    "api:extract": "api-extractor run --local",
    "api:update": "api-extractor run --local --update",
    "security:audit": "audit-ci --config .audit-ci.json",
    "security:snyk": "snyk test",
    "security:snyk:monitor": "snyk monitor",
    "deps:check": "depcheck",
    "deps:outdated": "pnpm outdated",
    "analyze:bundle": "webpack-bundle-analyzer dist/index.es.js",
    "clean": "rm -rf dist coverage docs/api",
    "precommit": "lint-staged",
    "prepush": "pnpm test && pnpm type-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@microsoft/api-extractor": "^7.53.1",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "audit-ci": "^7.1.0",
    "c8": "^10.1.3",
    "depcheck": "^1.4.7",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "poku": "^3.0.2",
    "prettier": "^3.6.2",
    "snyk": "^1.1300.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
